# ── Required ───────────────────────────────────────────────────────
# Get your free key at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ── Optional: LLM model override ──────────────────────────────────
DEFAULT_LLM_MODEL=meta-llama/llama-3.3-8b-instruct:free

# ── Optional: HF Dataset persistence ──────────────────────────────
# Enables cross-restart ChromaDB persistence via HF Dataset repo
# 1. Create a PRIVATE dataset repo on HuggingFace
# 2. Generate an HF token with write access
# 3. Set the values below
HF_TOKEN=hf_your_token_here
HF_DATASET_REPO=Devendra-Pudi/smartai-notes-db
USE_HF_PERSISTENCE=false
